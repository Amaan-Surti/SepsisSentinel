# Virtual Environment
.venv/
venv/
ENV/

# Data (preserve .gitkeep)
data/**/*
!data/**/
!data/**/.gitkeep
# Small demo cohort is tracked so the dashboard/Docker work from a clean clone
!data/demo/*

# Models and MLflow
models/*
!models/.gitkeep
# Frozen final model (4 MB) is tracked for the API/Docker
!models/final/
!models/final/**
# Dev-only LightGBM + GRU ensemble served by the API (P9)
!models/ensemble_final/
!models/ensemble_final/**
mlruns/
logs/

# Python cache and checkpoints
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Frontend
frontend/node_modules/
frontend/dist/

# OS files
.DS_Store
Thumbs.db
